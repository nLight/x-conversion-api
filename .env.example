# Generate a separate random ingestion secret for each trusted application producer:
# openssl rand -hex 32
# Server-side producers only. Never embed this secret or the X token in an APK/IPA.
EXAMPLE_INGEST_TOKEN=

# X Ads Manager -> Send events to X App Conversion API -> Generate access token.
# The service accepts events without this token and keeps them in its durable outbox.
# Set the token and restart the process/container to enable delivery.
X_APP_CONVERSION_TOKEN=

# Optional: only for the manually invoked cmd/send-test tool.
# A real consenting Android test device's raw advertising UUID, not an install UUID.
X_TEST_DEVICE_ID=

# Docker Compose: existing external volume mounted at /data.
# Create once with: docker volume create conversion-api-data
CONVERSION_DATA_VOLUME=conversion-api-data
